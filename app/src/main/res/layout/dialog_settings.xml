<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Настройки L.I.R.A."
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ваше имя"
        android:layout_marginBottom="12dp"/>

    <Switch
        android:id="@+id/switchTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Темная тема"
        android:layout_marginBottom="12dp"/>

    <Switch
        android:id="@+id/switchVoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Озвучивать ответы голосом (TTS)"
        android:layout_marginBottom="12dp"/>

    <Switch
        android:id="@+id/switchWidget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Плавающий виджет поверх окон"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Добавить свою команду:"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etCustomKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Фраза (например: какая погода)"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etCustomVal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ответ ассистента"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnAddCustom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить команду"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnClearChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Очистить историю чата"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Применить и закрыть"
        android:backgroundTint="#1B4D3E"/>

</LinearLayout>
