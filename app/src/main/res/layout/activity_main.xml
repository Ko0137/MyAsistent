<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05050A">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#0B0B14">
        
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="L.I.R.A. v2.0"
            android:textColor="#00FFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <Switch
            android:id="@+id/voiceMuteSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Без звука"
            android:textColor="#A0A0C0"
            android:textSize="11sp"
            android:layout_marginEnd="6dp"/>

        <Switch
            android:id="@+id/widgetSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Виджет"
            android:textColor="#A0A0C0"
            android:textSize="11sp"/>
    </LinearLayout>

    <!-- Вторая строка панели управления для дополнительных кнопок -->
    <LinearLayout
        android:id="@+id/subTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:background="#0B0B14"
        android:gravity="end">

        <Button
            android:id="@+id/voiceBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Голос"
            android:textSize="10sp"
            android:layout_marginStart="4dp"
            android:background="#151525"
            android:textColor="#00FFFF"/>
            
        <Button
            android:id="@+id/policyBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Безопасность"
            android:textSize="10sp"
            android:layout_marginStart="4dp"
            android:background="#151525"
            android:textColor="#00FFFF"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/subTopBar"
        android:padding="16dp">
        
        <TextView
            android:id="@+id/chatDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF66"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:text="[System] Secure core online.\n[System] Say 'Лира [команда]' or use the floating widget."/>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#0B0B14">

        <Button
            android:id="@+id/micButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#00FFFF"
            android:text="🎤"
            android:textSize="18sp"
            android:textColor="#000000"/>

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:hint="Команда..."
            android:textColorHint="#505070"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:background="#121222"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"/>

        <Button
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#151525"
            android:text="➤"
            android:textColor="#00FFFF"
            android:textSize="16sp"/>
    </LinearLayout>
</RelativeLayout>
