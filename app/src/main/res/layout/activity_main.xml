<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="L.I.R.A. Assistant"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:paddingBottom="12dp"/>

    <!-- Блок настроек фоновых опций -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <Switch
            android:id="@+id/switchWidget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Плавающий виджет (фоновый режим)"
            android:textColor="#FFFFFF"
            android:paddingBottom="8dp"/>

        <Switch
            android:id="@+id/switchVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Голосовая активация"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Лог чата -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E1E1E"
        android:padding="8dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/chatLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:text="" />
    </ScrollView>

    <!-- Поле ввода текста и кнопка отправки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/inputMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Введите сообщение..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#00E676" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Отправить"
            android:backgroundTint="#00E676"
            android:textColor="#000000" />
    </LinearLayout>

</LinearLayout>
